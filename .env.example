# Application
APP_NAME=hotel-service
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# LLM
LLM_AUTH_KEY=your_sber_gigachat_auth_key_here
LLM_MODEL=GigaChat-2-Pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_VERIFY_SSL=false

# Cache
CACHE_BACKEND=redis
CACHE_TTL=259200
REDIS_URL=redis://localhost:6379/0

# Database (если потребуется)
DATABASE_URL=sqlite:///hotel_service.db
